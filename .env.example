# Supabase (obrigatório)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ElevenLabs — OPCIONAL, e a intenção é deixar de usar.
#
# Com esta variável preenchida, o navegador chama a ElevenLabs direto e a
# chave fica visível no JavaScript do site para qualquer pessoa que abrir o
# DevTools. Era o modo antigo.
#
# Sem ela, o app passa a usar a Edge Function `tts-proxy`, que guarda a chave
# no servidor. Para migrar:
#   1. supabase functions deploy tts-proxy
#   2. supabase secrets set ELEVEN_KEY=sk_...
#   3. apagar o secret VITE_ELEVEN_KEY do GitHub Actions e refazer o deploy
# Nenhuma mudança de código é necessária — o app detecta sozinho.
VITE_ELEVEN_KEY=

# REMOVIDO — chave Anthropic agora fica como secret no Supabase (nunca no browser)
# VITE_ANTHROPIC_KEY=sk-ant-...
